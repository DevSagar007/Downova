{
  "name": "dm-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "Free, account-free, cross-platform download manager (foundation phase).",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @dm/desktop dev:web",
    "dev:desktop": "pnpm --filter @dm/desktop tauri dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "contracts:gen": "node scripts/gen-contracts.mjs",
    "contracts:check": "node scripts/gen-contracts.mjs --check",
    "check:structure": "node scripts/check-structure.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:strict": "node scripts/verify.mjs --strict"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "ajv": "8.20.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.10",
    "smol-toml": "1.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "yaml": "2.9.1"
  }
}

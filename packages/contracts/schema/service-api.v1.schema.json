{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.dm.invalid/service-api.v1.schema.json",
  "title": "ServiceApiV1",
  "description": "Canonical service API contract v1. Source of truth for Rust (crates/domain::api) and generated TypeScript (packages/contracts/src/generated). See docs/architecture.md#service-api.",
  "type": "object",
  "$defs": {
    "JobId": {
      "description": "Service-owned logical job identifier. Never an aria2 GID.",
      "type": "string",
      "pattern": "^job_[0-9A-Za-z_-]{1,64}$"
    },
    "AttemptId": {
      "description": "Identifier of one transfer attempt of a job. Events from stale attempts are rejected.",
      "type": "string",
      "pattern": "^att_[0-9A-Za-z_-]{1,64}$"
    },
    "ByteCount": {
      "description": "Unsigned 64-bit byte count encoded as a decimal string (no sign, no leading zeros).",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "DesiredState": {
      "description": "What the user asked for. Only user commands change it; policy never does.",
      "type": "string",
      "enum": ["running", "paused", "cancelled"]
    },
    "Phase": {
      "description": "Where the job is in its lifecycle, independent of desired state and blockers.",
      "type": "string",
      "enum": [
        "queued",
        "probing",
        "transferring",
        "verifying",
        "scanning",
        "finalizing",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "Blocker": {
      "description": "Automatic policy condition holding an eligible job. Distinct from a manual user pause.",
      "type": "string",
      "enum": [
        "offline",
        "metered_network",
        "schedule_window",
        "rate_limit_cooldown",
        "disk_unavailable",
        "volume_missing",
        "queue_limit",
        "queue_stopped",
        "name_conflict"
      ]
    },
    "ErrorKind": {
      "description": "Stable, user-explainable failure classification (research §17.6).",
      "type": "string",
      "enum": [
        "NETWORK_OFFLINE",
        "AUTH_REQUIRED",
        "LINK_REFRESH_REQUIRED",
        "REMOTE_CHANGED",
        "RANGE_UNSUPPORTED",
        "INVALID_RANGE",
        "CHECKSUM_MISMATCH",
        "DISK_FULL",
        "VOLUME_MISSING",
        "DESTINATION_UNWRITABLE",
        "HOST_NOT_INSTALLED",
        "SCAN_BLOCKED",
        "BACKEND_CAPABILITY_UNAVAILABLE",
        "SERVER_BUSY",
        "TLS_HANDSHAKE_FAILED",
        "SERVICE_UNAVAILABLE",
        "INVALID_REQUEST",
        "IDEMPOTENCY_CONFLICT",
        "DUPLICATE_DOWNLOAD",
        "INTERNAL"
      ]
    },
    "NextAction": {
      "type": "string",
      "enum": [
        "none",
        "retry",
        "wait",
        "refresh_link",
        "sign_in",
        "free_disk_space",
        "reconnect_volume",
        "install_desktop_app",
        "choose_restart_or_keep",
        "contact_support"
      ]
    },
    "ErrorData": {
      "description": "Carried in JSON-RPC error.data and in failed job snapshots. Never contains secrets.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "retryable", "next_action"],
      "properties": {
        "kind": {
          "$ref": "#/$defs/ErrorKind"
        },
        "retryable": {
          "description": "The cause is transient: the same request may succeed later unchanged. Not a promise of an automatic retry.",
          "type": "boolean"
        },
        "next_action": {
          "$ref": "#/$defs/NextAction"
        },
        "detail": {
          "description": "Sanitized, user-safe detail. Must pass redaction rules.",
          "type": ["string", "null"]
        }
      }
    },
    "Capability": {
      "description": "Product-level capability a backend may or may not provide.",
      "type": "string",
      "enum": [
        "http",
        "https",
        "segmented_http",
        "resume_strong_validator",
        "durable_resume",
        "speed_limit_global",
        "speed_limit_per_job",
        "http_proxy",
        "socks5_proxy",
        "pac_proxy",
        "http2",
        "ftp",
        "sftp",
        "bittorrent",
        "metalink"
      ]
    },
    "CapabilitySupport": {
      "description": "unverified = documented upstream but not yet proven by project fixtures.",
      "type": "string",
      "enum": ["supported", "unsupported", "unverified"]
    },
    "CapabilityReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "support"],
      "properties": {
        "capability": {
          "$ref": "#/$defs/Capability"
        },
        "support": {
          "$ref": "#/$defs/CapabilitySupport"
        },
        "note": {
          "type": ["string", "null"]
        }
      }
    },
    "BackendInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "capabilities"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": ["string", "null"]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapabilityReport"
          }
        }
      }
    },
    "HelloResult": {
      "description": "Result of service.v1.hello.",
      "type": "object",
      "additionalProperties": false,
      "required": ["api_version", "service_version", "service_instance_id", "backend"],
      "properties": {
        "api_version": {
          "type": "integer",
          "const": 1
        },
        "service_version": {
          "type": "string"
        },
        "service_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "backend": {
          "$ref": "#/$defs/BackendInfo"
        }
      }
    },
    "DownloadSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {
          "description": "http(s) URL. Never logged unredacted.",
          "type": "string",
          "pattern": "^https?://"
        }
      }
    },
    "AddDownloadParams": {
      "description": "Params of downloads.v1.add. Same key + same request => same job; same key + different payload => IDEMPOTENCY_CONFLICT.",
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotency_key", "source", "destination_profile_id"],
      "properties": {
        "idempotency_key": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "source": {
          "$ref": "#/$defs/DownloadSource"
        },
        "destination_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "expected_size_bytes": {
          "oneOf": [
            {
              "$ref": "#/$defs/ByteCount"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/Sha256Hex"
            },
            {
              "type": "null"
            }
          ]
        },
        "category": {
          "$ref": "#/$defs/FileCategory",
          "description": "Destination category; omitted: chosen from the link's file name. The folder comes from the service's destination rules, never from the client."
        },
        "on_duplicate": {
          "$ref": "#/$defs/DuplicatePolicy"
        },
        "queue_id": {
          "$ref": "#/$defs/QueueId",
          "description": "Queue for the job; omitted: 'main'."
        }
      }
    },
    "Verification": {
      "description": "How a completed file was checked (B1.3). local_hash: Downova computed the SHA-256 of the placed file; nothing trusted was given to compare it with. publisher_checksum: the computed SHA-256 matched the trusted expected_sha256 given with the request.",
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "source"],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source": {
          "type": "string",
          "enum": ["local_hash", "publisher_checksum"]
        }
      }
    },
    "DownloadSnapshot": {
      "description": "Sanitized job state presented by UI/CLI. Progress is live, not a durability checkpoint.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "attempt_id",
        "display_name",
        "source_display",
        "desired_state",
        "phase",
        "blockers",
        "downloaded_bytes",
        "total_bytes",
        "error"
      ],
      "properties": {
        "verification": {
          "description": "Set when the job completed: the SHA-256 of the final file and whether it matched a trusted checksum. Absent or null otherwise.",
          "oneOf": [
            {
              "$ref": "#/$defs/Verification"
            },
            {
              "type": "null"
            }
          ]
        },
        "job_id": {
          "$ref": "#/$defs/JobId"
        },
        "attempt_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/AttemptId"
            },
            {
              "type": "null"
            }
          ]
        },
        "display_name": {
          "type": "string"
        },
        "source_display": {
          "description": "Redacted URL: no userinfo, query values or fragment.",
          "type": "string"
        },
        "desired_state": {
          "$ref": "#/$defs/DesiredState"
        },
        "phase": {
          "$ref": "#/$defs/Phase"
        },
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Blocker"
          }
        },
        "downloaded_bytes": {
          "$ref": "#/$defs/ByteCount"
        },
        "total_bytes": {
          "oneOf": [
            {
              "$ref": "#/$defs/ByteCount"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "oneOf": [
            {
              "$ref": "#/$defs/ErrorData"
            },
            {
              "type": "null"
            }
          ]
        },
        "removed": {
          "description": "True once the job was removed from the list (ADR 0013): it is omitted from downloads.v1.list but still answers get and replays of its original add. Absent or false otherwise. Removal never deletes files.",
          "type": "boolean"
        },
        "queue_id": {
          "$ref": "#/$defs/QueueId"
        },
        "priority": {
          "$ref": "#/$defs/Priority"
        },
        "queue_position": {
          "$ref": "#/$defs/ByteCount",
          "description": "Manual execution position inside the queue (smaller first). Not a display sort."
        },
        "category": {
          "$ref": "#/$defs/FileCategory"
        }
      }
    },
    "EventKind": {
      "type": "string",
      "enum": ["snapshot_required", "job_added", "job_changed", "progress", "job_removed"]
    },
    "ServiceEvent": {
      "description": "events.v1.subscribe stream item. A sequence gap or new service_instance_id requires a fresh snapshot.",
      "type": "object",
      "additionalProperties": false,
      "required": ["service_instance_id", "sequence", "kind", "job_id", "attempt_id", "snapshot"],
      "properties": {
        "service_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "$ref": "#/$defs/ByteCount"
        },
        "kind": {
          "$ref": "#/$defs/EventKind"
        },
        "job_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/JobId"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempt_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/AttemptId"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot": {
          "oneOf": [
            {
              "$ref": "#/$defs/DownloadSnapshot"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "JobRef": {
      "description": "Params of downloads.v1.get / pause / resume / cancel / remove.",
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id"],
      "properties": {
        "job_id": {
          "$ref": "#/$defs/JobId"
        }
      }
    },
    "ListDownloadsResult": {
      "description": "Result of downloads.v1.list (sanitized snapshots, insertion order).",
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DownloadSnapshot"
          }
        }
      }
    },
    "EmptyResult": {
      "description": "Result of methods that only acknowledge (e.g. service.v1.shutdown).",
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "ShutdownMode": {
      "description": "How service.v1.shutdown leaves unfinished downloads (ADR 0012). keep_state: they continue after the next start (the default, also used for Ctrl+C). pause_downloads: \"Exit and stop downloads\" — each running download is paused (manual pause, persisted with its checkpoint) and stays paused until the user resumes it.",
      "type": "string",
      "enum": ["keep_state", "pause_downloads"]
    },
    "ShutdownParams": {
      "description": "Params of service.v1.shutdown. {} means keep_state. Unknown fields or modes are rejected and never stop the service.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/$defs/ShutdownMode"
        }
      }
    },
    "ShutdownResult": {
      "description": "Acknowledgement of service.v1.shutdown, sent after the paused intent is durable and before the process exits. It does not prove that the process has ended; clients check that separately.",
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "paused_jobs"],
      "properties": {
        "mode": {
          "$ref": "#/$defs/ShutdownMode"
        },
        "paused_jobs": {
          "description": "Unfinished downloads paused by this request (0 for keep_state).",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "RpcRequest": {
      "description": "JSON-RPC 2.0 request, one per line over the local IPC endpoint. Request id correlation is separate from job idempotency.",
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "method": {
          "type": "string",
          "enum": [
            "service.v1.hello",
            "service.v1.shutdown",
            "downloads.v1.add",
            "downloads.v1.list",
            "downloads.v1.get",
            "downloads.v1.pause",
            "downloads.v1.resume",
            "downloads.v1.cancel",
            "downloads.v1.remove",
            "downloads.v1.check",
            "downloads.v1.confirm_name",
            "downloads.v1.set_queue",
            "downloads.v1.set_priority",
            "downloads.v1.move",
            "settings.v1.get",
            "settings.v1.set",
            "queues.v1.list",
            "queues.v1.create",
            "queues.v1.rename",
            "queues.v1.delete",
            "queues.v1.set_limit",
            "queues.v1.start",
            "queues.v1.stop",
            "events.v1.subscribe",
            "history.v1.get",
            "history.v1.set",
            "history.v1.preview",
            "history.v1.clean"
          ]
        },
        "params": {
          "type": "object"
        }
      }
    },
    "RpcError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "data"],
      "properties": {
        "code": {
          "description": "-32700 parse, -32600 invalid request, -32601 unknown method, -32602 invalid params, -32000 download/service error.",
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "oneOf": [
            {
              "$ref": "#/$defs/ErrorData"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "RpcResponse": {
      "description": "Exactly one of result / error is present.",
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id"],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": ["string", "null"]
        },
        "result": {},
        "error": {
          "$ref": "#/$defs/RpcError"
        }
      },
      "oneOf": [
        {
          "properties": {
            "result": true
          },
          "required": ["result"],
          "not": {
            "properties": {
              "error": true
            },
            "required": ["error"]
          }
        },
        {
          "properties": {
            "error": true
          },
          "required": ["error"],
          "not": {
            "properties": {
              "result": true
            },
            "required": ["result"]
          }
        }
      ]
    },
    "NativeHostHello": {
      "description": "Browser native host (B0.6): is a compatible download service reachable?",
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "request_id", "op"],
      "properties": {
        "v": {
          "type": "integer",
          "const": 1
        },
        "request_id": {
          "description": "Chosen by the extension per message; echoed in the response.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,64}$"
        },
        "op": {
          "const": "hello"
        }
      }
    },
    "NativeHostAdd": {
      "description": "Browser native host (B0.6): explicit hand-off of one public http(s) GET link. The host adds destination profile \"downloads\" and forwards downloads.v1.add with this idempotency key. No cookies, headers, POST bodies or file bytes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "request_id", "op", "url", "idempotency_key"],
      "properties": {
        "v": {
          "type": "integer",
          "const": 1
        },
        "request_id": {
          "description": "Chosen by the extension per message; echoed in the response.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,64}$"
        },
        "op": {
          "const": "add"
        },
        "url": {
          "description": "http(s) URL without userinfo; at most 8192 characters. Never logged unredacted.",
          "type": "string",
          "maxLength": 8192,
          "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$"
        }
      }
    },
    "NativeHostRequest": {
      "description": "One native-messaging request from the extension. Only these operations exist; arbitrary service RPC is never forwarded.",
      "oneOf": [
        {
          "$ref": "#/$defs/NativeHostHello"
        },
        {
          "$ref": "#/$defs/NativeHostAdd"
        }
      ]
    },
    "NativeHostOutcome": {
      "description": "service_ready: hello answered. accepted: the service created (or returned, for the same key) the job — not that a transfer started or finished. rejected: the request or URL is not supported. unavailable: host, service or capability missing. uncertain: no acknowledgement in time; retry with the SAME idempotency key.",
      "type": "string",
      "enum": ["service_ready", "accepted", "rejected", "unavailable", "uncertain"]
    },
    "NativeHostResponse": {
      "description": "Native host reply. request_id is null only when the request could not be parsed.",
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "request_id", "outcome"],
      "properties": {
        "v": {
          "type": "integer",
          "const": 1
        },
        "request_id": {
          "type": ["string", "null"]
        },
        "outcome": {
          "$ref": "#/$defs/NativeHostOutcome"
        },
        "job": {
          "oneOf": [
            {
              "$ref": "#/$defs/DownloadSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "hello": {
          "oneOf": [
            {
              "$ref": "#/$defs/HelloResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "oneOf": [
            {
              "$ref": "#/$defs/ErrorData"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "FileCategory": {
      "description": "File-type category for destination rules (B2.8, ADR 0015). 'other' is everything no default extension rule matches.",
      "type": "string",
      "enum": ["compressed", "documents", "music", "programs", "video", "other"]
    },
    "DuplicatePolicy": {
      "description": "What downloads.v1.add does when an unremoved job has the same link identity. Omitted means 'allow' (the behaviour before B2.8).",
      "type": "string",
      "enum": ["allow", "refuse"]
    },
    "CollisionPolicy": {
      "description": "When a final name is taken: 'rename' uses the next free name; 'ask' holds the verified file (blocker name_conflict) until downloads.v1.confirm_name or cancel. Nothing is ever overwritten.",
      "type": "string",
      "enum": ["rename", "ask"]
    },
    "Priority": {
      "description": "Admission priority (B2.11, ADR 0017). Global: a higher priority starts first; ties follow queue order, then manual position, then acceptance time.",
      "type": "string",
      "enum": ["low", "normal", "high"]
    },
    "QueueId": {
      "description": "Queue identifier: 'main' (the default queue) or a service-generated 'q_…'.",
      "type": "string",
      "pattern": "^(main|q_[0-9a-f]{1,64})$"
    },
    "CheckLinkParams": {
      "description": "Params of downloads.v1.check (B2.8).",
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "$ref": "#/$defs/DownloadSource"
        }
      }
    },
    "DuplicateSummary": {
      "description": "An unremoved job with the same link identity. Never carries the URL.",
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "display_name", "phase", "desired_state"],
      "properties": {
        "job_id": {
          "$ref": "#/$defs/JobId"
        },
        "display_name": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/Phase"
        },
        "desired_state": {
          "$ref": "#/$defs/DesiredState"
        }
      }
    },
    "CheckLinkResult": {
      "description": "Result of downloads.v1.check: same-link jobs, oldest first. Link identity is the exact URL with only scheme and host case-folded; redacted URLs are never compared.",
      "type": "object",
      "additionalProperties": false,
      "required": ["duplicates"],
      "properties": {
        "duplicates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DuplicateSummary"
          }
        }
      }
    },
    "DestinationRule": {
      "description": "Category to folder mapping. The folder is an absolute, existing local directory without . or .. components.",
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "directory"],
      "properties": {
        "category": {
          "$ref": "#/$defs/FileCategory"
        },
        "directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "ServiceSettings": {
      "description": "settings.v1.get result and settings.v1.set params (replaces the whole value). Rule edits never move existing jobs.",
      "type": "object",
      "additionalProperties": false,
      "required": ["destination_rules", "on_collision"],
      "properties": {
        "destination_rules": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/DestinationRule"
          }
        },
        "on_collision": {
          "$ref": "#/$defs/CollisionPolicy"
        }
      }
    },
    "QueueInfo": {
      "description": "A download queue (B2.11).",
      "type": "object",
      "additionalProperties": false,
      "required": ["queue_id", "name", "position", "max_active", "running"],
      "properties": {
        "queue_id": {
          "$ref": "#/$defs/QueueId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "max_active": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "running": {
          "type": "boolean",
          "description": "False after queues.v1.stop: its jobs hold with queue_stopped."
        }
      }
    },
    "ListQueuesResult": {
      "description": "Result of queues.v1.list, in list order.",
      "type": "object",
      "additionalProperties": false,
      "required": ["queues"],
      "properties": {
        "queues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QueueInfo"
          }
        }
      }
    },
    "CreateQueueParams": {
      "description": "Params of queues.v1.create.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "max_active": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      }
    },
    "QueueRef": {
      "description": "Params of queues.v1.start / queues.v1.stop.",
      "type": "object",
      "additionalProperties": false,
      "required": ["queue_id"],
      "properties": {
        "queue_id": {
          "$ref": "#/$defs/QueueId"
        }
      }
    },
    "RenameQueueParams": {
      "description": "Params of queues.v1.rename.",
      "type": "object",
      "additionalProperties": false,
      "required": ["queue_id", "name"],
      "properties": {
        "queue_id": {
          "$ref": "#/$defs/QueueId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "SetQueueLimitParams": {
      "description": "Params of queues.v1.set_limit. Lowering never stops a running transfer.",
      "type": "object",
      "additionalProperties": false,
      "required": ["queue_id", "max_active"],
      "properties": {
        "queue_id": {
          "$ref": "#/$defs/QueueId"
        },
        "max_active": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      }
    },
    "DeleteQueueParams": {
      "description": "Params of queues.v1.delete. Never deletes jobs or files: a queue with jobs needs move_to; 'main' cannot be deleted.",
      "type": "object",
      "additionalProperties": false,
      "required": ["queue_id"],
      "properties": {
        "queue_id": {
          "$ref": "#/$defs/QueueId"
        },
        "move_to": {
          "$ref": "#/$defs/QueueId"
        }
      }
    },
    "SetJobQueueParams": {
      "description": "Params of downloads.v1.set_queue: the job moves to the end of the queue.",
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "queue_id"],
      "properties": {
        "job_id": {
          "$ref": "#/$defs/JobId"
        },
        "queue_id": {
          "$ref": "#/$defs/QueueId"
        }
      }
    },
    "SetPriorityParams": {
      "description": "Params of downloads.v1.set_priority.",
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "priority"],
      "properties": {
        "job_id": {
          "$ref": "#/$defs/JobId"
        },
        "priority": {
          "$ref": "#/$defs/Priority"
        }
      }
    },
    "MoveTarget": {
      "type": "string",
      "enum": ["up", "down", "top", "bottom"]
    },
    "MoveJobParams": {
      "description": "Params of downloads.v1.move: manual execution order inside the job's queue.",
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "to"],
      "properties": {
        "job_id": {
          "$ref": "#/$defs/JobId"
        },
        "to": {
          "$ref": "#/$defs/MoveTarget"
        }
      }
    },
    "SubscribeResult": {
      "description": "Result of events.v1.subscribe (B2.9): an authoritative list and the sequence it reflects. Each later events.v1.event on the same connection has sequence = previous + 1; a gap, snapshot_required or another service_instance_id means: subscribe again.",
      "type": "object",
      "additionalProperties": false,
      "required": ["service_instance_id", "sequence", "items"],
      "properties": {
        "service_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "$ref": "#/$defs/ByteCount"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DownloadSnapshot"
          }
        }
      }
    },
    "RpcNotification": {
      "description": "Server-to-client notification on a subscribed connection (no id, no answer).",
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "events.v1.event"
        },
        "params": {
          "$ref": "#/$defs/ServiceEvent"
        }
      }
    },
    "HistorySettings": {
      "description": "history.v1.get result and history.v1.set params (B2.12, ADR 0018). Finished jobs (completed, failed, cancelled) leave the list retention_days after they finished; null (the default) keeps them indefinitely. Downloaded and partial files are never touched. Separate from settings.v1 so clients that save destination settings cannot change it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["retention_days"],
      "properties": {
        "retention_days": {
          "description": "Days after a finished job finished; null keeps history indefinitely.",
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 3650
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "HistoryPreviewParams": {
      "description": "Params of history.v1.preview: the policy to evaluate now (not saved).",
      "type": "object",
      "additionalProperties": false,
      "required": ["retention_days"],
      "properties": {
        "retention_days": {
          "description": "Days after a finished job finished; null keeps history indefinitely.",
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 3650
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "HistoryPreview": {
      "description": "Result of history.v1.preview: listed finished jobs the policy would remove now (expiring) and all listed finished jobs (finished).",
      "type": "object",
      "additionalProperties": false,
      "required": ["expiring", "finished"],
      "properties": {
        "expiring": {
          "type": "integer",
          "minimum": 0
        },
        "finished": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "HistoryCleanResult": {
      "description": "Result of history.v1.clean: jobs removed from the list now (removed) and eligible jobs kept because their removal could not be recorded (kept; retried later).",
      "type": "object",
      "additionalProperties": false,
      "required": ["removed", "kept"],
      "properties": {
        "removed": {
          "type": "integer",
          "minimum": 0
        },
        "kept": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.dm.invalid/service-api.v1.schema.json",
  "title": "ServiceApiV1",
  "description": "Canonical service API contract v1. Source of truth for Rust (crates/domain::api) and generated TypeScript (packages/contracts/src/generated). See docs/architecture.md#service-api.",
  "type": "object",
  "$defs": {
    "JobId": {
      "description": "Service-owned logical job identifier. Never an aria2 GID.",
      "type": "string",
      "pattern": "^job_[0-9A-Za-z_-]{1,64}$"
    },
    "AttemptId": {
      "description": "Identifier of one transfer attempt of a job. Events from stale attempts are rejected.",
      "type": "string",
      "pattern": "^att_[0-9A-Za-z_-]{1,64}$"
    },
    "ByteCount": {
      "description": "Unsigned 64-bit byte count encoded as a decimal string (no sign, no leading zeros).",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "DesiredState": {
      "description": "What the user asked for. Only user commands change it; policy never does.",
      "type": "string",
      "enum": ["running", "paused", "cancelled"]
    },
    "Phase": {
      "description": "Where the job is in its lifecycle, independent of desired state and blockers.",
      "type": "string",
      "enum": [
        "queued",
        "probing",
        "transferring",
        "verifying",
        "scanning",
        "finalizing",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "Blocker": {
      "description": "Automatic policy condition holding an eligible job. Distinct from a manual user pause.",
      "type": "string",
      "enum": [
        "offline",
        "metered_network",
        "schedule_window",
        "rate_limit_cooldown",
        "disk_unavailable",
        "volume_missing",
        "queue_limit"
      ]
    },
    "ErrorKind": {
      "description": "Stable, user-explainable failure classification (research §17.6).",
      "type": "string",
      "enum": [
        "NETWORK_OFFLINE",
        "AUTH_REQUIRED",
        "LINK_REFRESH_REQUIRED",
        "REMOTE_CHANGED",
        "RANGE_UNSUPPORTED",
        "INVALID_RANGE",
        "CHECKSUM_MISMATCH",
        "DISK_FULL",
        "VOLUME_MISSING",
        "DESTINATION_UNWRITABLE",
        "HOST_NOT_INSTALLED",
        "SCAN_BLOCKED",
        "BACKEND_CAPABILITY_UNAVAILABLE",
        "SERVER_BUSY",
        "TLS_HANDSHAKE_FAILED",
        "SERVICE_UNAVAILABLE",
        "INVALID_REQUEST",
        "IDEMPOTENCY_CONFLICT",
        "INTERNAL"
      ]
    },
    "NextAction": {
      "type": "string",
      "enum": [
        "none",
        "retry",
        "wait",
        "refresh_link",
        "sign_in",
        "free_disk_space",
        "reconnect_volume",
        "install_desktop_app",
        "choose_restart_or_keep",
        "contact_support"
      ]
    },
    "ErrorData": {
      "description": "Carried in JSON-RPC error.data and in failed job snapshots. Never contains secrets.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "retryable", "next_action"],
      "properties": {
        "kind": { "$ref": "#/$defs/ErrorKind" },
        "retryable": { "type": "boolean" },
        "next_action": { "$ref": "#/$defs/NextAction" },
        "detail": {
          "description": "Sanitized, user-safe detail. Must pass redaction rules.",
          "type": ["string", "null"]
        }
      }
    },
    "Capability": {
      "description": "Product-level capability a backend may or may not provide.",
      "type": "string",
      "enum": [
        "http",
        "https",
        "segmented_http",
        "resume_strong_validator",
        "durable_resume",
        "speed_limit_global",
        "speed_limit_per_job",
        "http_proxy",
        "socks5_proxy",
        "pac_proxy",
        "http2",
        "ftp",
        "sftp",
        "bittorrent",
        "metalink"
      ]
    },
    "CapabilitySupport": {
      "description": "unverified = documented upstream but not yet proven by project fixtures.",
      "type": "string",
      "enum": ["supported", "unsupported", "unverified"]
    },
    "CapabilityReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "support"],
      "properties": {
        "capability": { "$ref": "#/$defs/Capability" },
        "support": { "$ref": "#/$defs/CapabilitySupport" },
        "note": { "type": ["string", "null"] }
      }
    },
    "BackendInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "capabilities"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "null"] },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/CapabilityReport" }
        }
      }
    },
    "HelloResult": {
      "description": "Result of service.v1.hello.",
      "type": "object",
      "additionalProperties": false,
      "required": ["api_version", "service_version", "service_instance_id", "backend"],
      "properties": {
        "api_version": { "type": "integer", "const": 1 },
        "service_version": { "type": "string" },
        "service_instance_id": { "type": "string", "minLength": 1 },
        "backend": { "$ref": "#/$defs/BackendInfo" }
      }
    },
    "DownloadSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {
          "description": "http(s) URL. Never logged unredacted.",
          "type": "string",
          "pattern": "^https?://"
        }
      }
    },
    "AddDownloadParams": {
      "description": "Params of downloads.v1.add. Same key + same request => same job; same key + different payload => IDEMPOTENCY_CONFLICT.",
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotency_key", "source", "destination_profile_id"],
      "properties": {
        "idempotency_key": { "type": "string", "minLength": 8, "maxLength": 128 },
        "source": { "$ref": "#/$defs/DownloadSource" },
        "destination_profile_id": { "type": "string", "minLength": 1 },
        "expected_size_bytes": {
          "oneOf": [{ "$ref": "#/$defs/ByteCount" }, { "type": "null" }]
        },
        "expected_sha256": {
          "oneOf": [{ "$ref": "#/$defs/Sha256Hex" }, { "type": "null" }]
        }
      }
    },
    "Verification": {
      "description": "How a completed file was checked (B1.3). local_hash: Downova computed the SHA-256 of the placed file; nothing trusted was given to compare it with. publisher_checksum: the computed SHA-256 matched the trusted expected_sha256 given with the request.",
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "source"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "source": { "type": "string", "enum": ["local_hash", "publisher_checksum"] }
      }
    },
    "DownloadSnapshot": {
      "description": "Sanitized job state presented by UI/CLI. Progress is live, not a durability checkpoint.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "attempt_id",
        "display_name",
        "source_display",
        "desired_state",
        "phase",
        "blockers",
        "downloaded_bytes",
        "total_bytes",
        "error"
      ],
      "properties": {
        "verification": {
          "description": "Set when the job completed: the SHA-256 of the final file and whether it matched a trusted checksum. Absent or null otherwise.",
          "oneOf": [{ "$ref": "#/$defs/Verification" }, { "type": "null" }]
        },
        "job_id": { "$ref": "#/$defs/JobId" },
        "attempt_id": {
          "oneOf": [{ "$ref": "#/$defs/AttemptId" }, { "type": "null" }]
        },
        "display_name": { "type": "string" },
        "source_display": {
          "description": "Redacted URL: no userinfo, query values or fragment.",
          "type": "string"
        },
        "desired_state": { "$ref": "#/$defs/DesiredState" },
        "phase": { "$ref": "#/$defs/Phase" },
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Blocker" }
        },
        "downloaded_bytes": { "$ref": "#/$defs/ByteCount" },
        "total_bytes": {
          "oneOf": [{ "$ref": "#/$defs/ByteCount" }, { "type": "null" }]
        },
        "error": {
          "oneOf": [{ "$ref": "#/$defs/ErrorData" }, { "type": "null" }]
        }
      }
    },
    "EventKind": {
      "type": "string",
      "enum": ["snapshot_required", "job_added", "job_changed", "progress", "job_removed"]
    },
    "ServiceEvent": {
      "description": "events.v1.subscribe stream item. A sequence gap or new service_instance_id requires a fresh snapshot.",
      "type": "object",
      "additionalProperties": false,
      "required": ["service_instance_id", "sequence", "kind", "job_id", "attempt_id", "snapshot"],
      "properties": {
        "service_instance_id": { "type": "string", "minLength": 1 },
        "sequence": { "$ref": "#/$defs/ByteCount" },
        "kind": { "$ref": "#/$defs/EventKind" },
        "job_id": {
          "oneOf": [{ "$ref": "#/$defs/JobId" }, { "type": "null" }]
        },
        "attempt_id": {
          "oneOf": [{ "$ref": "#/$defs/AttemptId" }, { "type": "null" }]
        },
        "snapshot": {
          "oneOf": [{ "$ref": "#/$defs/DownloadSnapshot" }, { "type": "null" }]
        }
      }
    },
    "JobRef": {
      "description": "Params of downloads.v1.get / pause / resume / cancel.",
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id"],
      "properties": {
        "job_id": { "$ref": "#/$defs/JobId" }
      }
    },
    "ListDownloadsResult": {
      "description": "Result of downloads.v1.list (sanitized snapshots, insertion order).",
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/DownloadSnapshot" } }
      }
    },
    "EmptyResult": {
      "description": "Result of methods that only acknowledge (e.g. service.v1.shutdown).",
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "RpcRequest": {
      "description": "JSON-RPC 2.0 request, one per line over the local IPC endpoint. Request id correlation is separate from job idempotency.",
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "method": {
          "type": "string",
          "enum": [
            "service.v1.hello",
            "service.v1.shutdown",
            "downloads.v1.add",
            "downloads.v1.list",
            "downloads.v1.get",
            "downloads.v1.pause",
            "downloads.v1.resume",
            "downloads.v1.cancel"
          ]
        },
        "params": { "type": "object" }
      }
    },
    "RpcError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "data"],
      "properties": {
        "code": {
          "description": "-32700 parse, -32600 invalid request, -32601 unknown method, -32602 invalid params, -32000 download/service error.",
          "type": "integer"
        },
        "message": { "type": "string" },
        "data": {
          "oneOf": [{ "$ref": "#/$defs/ErrorData" }, { "type": "null" }]
        }
      }
    },
    "RpcResponse": {
      "description": "Exactly one of result / error is present.",
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": ["string", "null"] },
        "result": {},
        "error": { "$ref": "#/$defs/RpcError" }
      },
      "oneOf": [
        {
          "properties": { "result": true },
          "required": ["result"],
          "not": { "properties": { "error": true }, "required": ["error"] }
        },
        {
          "properties": { "error": true },
          "required": ["error"],
          "not": { "properties": { "result": true }, "required": ["result"] }
        }
      ]
    },
    "NativeHostHello": {
      "description": "Browser native host (B0.6): is a compatible download service reachable?",
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "request_id", "op"],
      "properties": {
        "v": {
          "type": "integer",
          "const": 1
        },
        "request_id": {
          "description": "Chosen by the extension per message; echoed in the response.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,64}$"
        },
        "op": {
          "const": "hello"
        }
      }
    },
    "NativeHostAdd": {
      "description": "Browser native host (B0.6): explicit hand-off of one public http(s) GET link. The host adds destination profile \"downloads\" and forwards downloads.v1.add with this idempotency key. No cookies, headers, POST bodies or file bytes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "request_id", "op", "url", "idempotency_key"],
      "properties": {
        "v": {
          "type": "integer",
          "const": 1
        },
        "request_id": {
          "description": "Chosen by the extension per message; echoed in the response.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,64}$"
        },
        "op": {
          "const": "add"
        },
        "url": {
          "description": "http(s) URL without userinfo; at most 8192 characters. Never logged unredacted.",
          "type": "string",
          "maxLength": 8192,
          "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$"
        }
      }
    },
    "NativeHostRequest": {
      "description": "One native-messaging request from the extension. Only these operations exist; arbitrary service RPC is never forwarded.",
      "oneOf": [
        {
          "$ref": "#/$defs/NativeHostHello"
        },
        {
          "$ref": "#/$defs/NativeHostAdd"
        }
      ]
    },
    "NativeHostOutcome": {
      "description": "service_ready: hello answered. accepted: the service created (or returned, for the same key) the job — not that a transfer started or finished. rejected: the request or URL is not supported. unavailable: host, service or capability missing. uncertain: no acknowledgement in time; retry with the SAME idempotency key.",
      "type": "string",
      "enum": ["service_ready", "accepted", "rejected", "unavailable", "uncertain"]
    },
    "NativeHostResponse": {
      "description": "Native host reply. request_id is null only when the request could not be parsed.",
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "request_id", "outcome"],
      "properties": {
        "v": {
          "type": "integer",
          "const": 1
        },
        "request_id": {
          "type": ["string", "null"]
        },
        "outcome": {
          "$ref": "#/$defs/NativeHostOutcome"
        },
        "job": {
          "oneOf": [
            {
              "$ref": "#/$defs/DownloadSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "hello": {
          "oneOf": [
            {
              "$ref": "#/$defs/HelloResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "oneOf": [
            {
              "$ref": "#/$defs/ErrorData"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
